#!/usr/bin/env python3
"""Send an email with two PDF attachments over SMTP (SendGrid compatible).

Credentials come from environment variables (or prompts if missing):

    SMTP_HOST      default: smtp.sendgrid.net
    SMTP_PORT      default: 587 (STARTTLS)
    SMTP_USER      default: apikey   (SendGrid's literal username)
    SMTP_PASSWORD  your SendGrid API key (or SMTP password)
    EMAIL_FROM     sender address (must be verified in SendGrid)

Usage:
    python send_pdfs.py --to you@example.com \
        --pdf1 /path/to/first.pdf --pdf2 /path/to/second.pdf \
        --subject "Your documents" --body "Please find both files attached."
"""

import argparse
import os
import smtplib
import sys
from email.message import EmailMessage
from getpass import getpass
from pathlib import Path


def get_credentials():
    host = os.getenv("SMTP_HOST", "smtp.mailgun.org")
    port = int(os.getenv("SMTP_PORT", "587"))
    user = os.getenv("SMTP_USER", "notifications@jacobhill.de")
    password = os.getenv("SMTP_PASSWORD") or getpass("SMTP password / API key: ")
    sender = os.getenv("EMAIL_FROM") or input("From address: ").strip()
    return host, port, user, password, sender


def attach_pdf(msg: EmailMessage, path_str: str) -> None:
    path = Path(path_str).expanduser()
    if not path.is_file():
        sys.exit(f"File not found: {path}")
    if path.suffix.lower() != ".pdf":
        print(f"Warning: {path.name} doesn't have a .pdf extension", file=sys.stderr)
    msg.add_attachment(
        path.read_bytes(),
        maintype="application",
        subtype="pdf",
        filename=path.name,
    )


def main():
    parser = argparse.ArgumentParser(description="Email two PDFs via SMTP.")
    parser.add_argument("--to", required=True, help="Recipient (comma-separate for multiple)")
    parser.add_argument("--pdf1", required=True, help="Path to first PDF")
    parser.add_argument("--pdf2", required=True, help="Path to second PDF")
    parser.add_argument("--subject", default="Documents attached")
    parser.add_argument("--body", default="Please find the attached PDFs.")
    args = parser.parse_args()

    host, port, user, password, sender = get_credentials()

    msg = EmailMessage()
    msg["From"] = sender
    msg["To"] = args.to
    msg["Subject"] = args.subject
    msg.set_content(args.body)

    attach_pdf(msg, args.pdf1)
    attach_pdf(msg, args.pdf2)

    try:
        with smtplib.SMTP(host, port, timeout=30) as server:
            server.starttls()
            server.login(user, password)
            server.send_message(msg)
    except smtplib.SMTPException as e:
        sys.exit(f"SMTP error: {e}")

    print(f"Sent to {args.to} with 2 attachments.")


if __name__ == "__main__":
    main()